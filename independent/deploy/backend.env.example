STORE_CORS=https://YOUR_DOMAIN
ADMIN_CORS=https://YOUR_PRIVATE_ADMIN_HOST
AUTH_CORS=https://YOUR_DOMAIN,https://YOUR_PRIVATE_ADMIN_HOST
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
DISABLE_ADMIN=false
STRYDE_TEST_MODE=false
STOREFRONT_URL=https://YOUR_DOMAIN
# Customer password recovery. Keep these server-only; verify the sender in Resend.
AUTH_EMAIL_MODE=resend
RESEND_API_KEY=
AUTH_FROM_EMAIL=
MEDIA_PUBLIC_URL=https://YOUR_DOMAIN/media
# Optional server-side catalog lookup, only after the required grant is obtained:
# STOCKX_API_KEY=
# STOCKX_ACCESS_TOKEN=
# STOCKX_CATALOG_USE_AUTHORIZATION=
