<div class="closing-stage" data-closing-stage>
  <div class="closing-editorial" data-closing-copy>
    <h2 class="closing-heading" id="FinaleHeading-{{ section.id }}">
      <span>{{ section.settings.heading_line_1 | upcase | escape }}</span>
      <span>{{ section.settings.heading_line_2 | upcase | escape }}</span>
    </h2>
    <p>{{ section.settings.sub | escape }}</p>
  </div>
  <div class="closing-gallery" aria-label="Discover the footwear edit">
    <a class="closing-photo closing-photo-archive" data-closing-photo href="{{ routes.all_products_collection_url }}?edit=stockx&amp;brand=adidas">
      <img src="{{ 'stockx-edit/stockx-0001.webp' | asset_url }}" width="800" height="857" loading="lazy" alt="adidas Samba OG Cloud White Core Black">
      <span>ADIDAS <strong>Samba OG</strong></span>
    </a>
    <a class="closing-photo closing-photo-archive" data-closing-photo href="{{ routes.all_products_collection_url }}?edit=stockx&amp;brand=New%20Balance">
      <img src="{{ 'stockx-edit/stockx-0019.jpg' | asset_url }}" width="800" height="600" loading="lazy" alt="New Balance 9060 Sea Salt White">
      <span>NEW BALANCE <strong>9060</strong></span>
    </a>
    <a class="closing-photo closing-photo-archive" data-closing-photo href="{{ routes.all_products_collection_url }}?edit=stockx&amp;brand=ASICS">
      <img src="{{ 'stockx-edit/stockx-0014.webp' | asset_url }}" width="800" height="857" loading="lazy" alt="ASICS GEL-1130 White Pure Silver">
      <span>ASICS <strong>GEL-1130</strong></span>
    </a>
    <a class="closing-photo closing-photo-focus" data-closing-focus href="{{ routes.all_products_collection_url }}?edit=stockx&amp;brand=Nike">
      <img src="{{ 'stockx-edit/stockx-0016.webp' | asset_url }}" width="800" height="600" loading="lazy" alt="Nike Air Max Plus Celestine Blue (Women's)">
      <span>NIKE <strong>Air Max Plus</strong>{% render 'icon', name: 'arrow' %}</span>
    </a>
  </div>
  <div class="closing-actions" data-closing-actions>
    <a class="closing-shop" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.cta | escape }} {% render 'icon', name: 'arrow' %}</a>
    <a class="closing-search" href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
  </div>
</div>
