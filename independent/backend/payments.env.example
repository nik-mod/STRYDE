# Documentation only. Do not copy fake values into a production environment.
# Existing database/session secrets belong in backend/.env, not in this file.
# Supply BANK-ISSUED SANDBOX credentials through your private server environment.
# Disabled by default; production checkout stays closed regardless of these flags.
TBC_PAYMENT_MODE=disabled
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_KEY=
TBC_PAYMENT_CURRENCIES=

BOG_PAYMENT_MODE=disabled
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_PAYMENT_CURRENCIES=

# Use bank-registered HTTPS URLs on a deployed test environment or approved tunnel.
# The backend origin must have no path, query string or trailing credentials.
PAYMENT_BACKEND_ORIGIN=
PAYMENT_RETURN_URL=
PAYMENT_BRIDGE_SECRET=
# Return URL should end in /checkout/payment on the storefront.
# Bridge secret must match the private storefront server environment.
# Public bank session creation is blocked; use the protected STRYDE flow.

# For sandbox Store API requests, existing STRYDE_TEST_MODE must also be true,
# NODE_ENV must not be production, and the selected bank mode must be sandbox.
# Select only currencies explicitly enabled by that bank for the sandbox merchant.
# No live mode is implemented until certification and checkout activation work pass.
