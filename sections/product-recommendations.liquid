{% comment %}
  Related products through Shopify's recommendation engine. Renders nothing until
  Shopify returns real recommendations; commerce.mjs fetches the section again via
  the recommendations route when it scrolls near the viewport.
{% endcomment %}
<section class="product-recommendations page-shell"
  {% unless recommendations.performed %}data-recommendations{% endunless %}
  data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.product_limit | default: 4 }}&intent=related"
  aria-label="{{ section.settings.heading | default: 'products.recommendations' | t | escape }}">
  {% if recommendations.performed %}
    {% if recommendations.products_count > 0 %}
      <header class="recommendations-heading">
        <span class="micro">{{ 'general.collection' | t }}</span>
        <h2>{{ section.settings.heading | default: 'products.recommendations' | t | escape }}</h2>
      </header>
      <div class="product-grid recommendations-grid">
        {% for recommendation in recommendations.products %}
          {% render 'product-card', card_product: recommendation %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</section>
{% schema %}
{"name":"Recommendations","settings":[{"type":"text","id":"heading","label":"Heading","info":"Leave blank to use the default translation."},{"type":"range","id":"product_limit","label":"Products to show","min":2,"max":8,"step":1,"default":4}]}
{% endschema %}
