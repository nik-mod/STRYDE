<section id="chapter-deconstruction" class="chapter chapter-surface chapter-deconstruction" {% if section.settings.use_tn_model %} data-tn-editorial{% endif %} data-chapter="deconstruction" data-env="deconstruction" data-section-id="{{ section.id }}" aria-labelledby="DeconHeading-{{ section.id }}">
  <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
  <h2 class="chapter-heading" id="DeconHeading-{{ section.id }}">
    <span class="heading-line"><span>{{ section.settings.heading_line_1 | escape }}</span></span>
    <span class="heading-line"><span>{{ section.settings.heading_line_2 | escape }}</span></span>
  </h2>
  <p class="chapter-intro">{{ section.settings.intro | escape }}</p>
  <div class="decon-grid">
    <div class="decon-list">
      {% for index in (1..5) %}
        {% case index %}
          {% when 1 %}{% assign title = section.settings.part_1_title %}{% assign body = section.settings.part_1_body %}
          {% when 2 %}{% assign title = section.settings.part_2_title %}{% assign body = section.settings.part_2_body %}
          {% when 3 %}{% assign title = section.settings.part_3_title %}{% assign body = section.settings.part_3_body %}
          {% when 4 %}{% assign title = section.settings.part_4_title %}{% assign body = section.settings.part_4_body %}
          {% when 5 %}{% assign title = section.settings.part_5_title %}{% assign body = section.settings.part_5_body %}
        {% endcase %}
        {% if title != blank %}
          <div class="decon-item">
            <span class="decon-num" aria-hidden="true">0{{ index }}</span>
            <div>
              <h3>{{ title | escape }}</h3>
              <p>{{ body | escape }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="decon-visual">
      <div class="frame decon-frame">
        <div class="decon-crop is-active" style="--zoom: {% if section.settings.use_tn_model %}1.32{% else %}1.25{% endif %}; --tx: 0%; --ty: 0%;">
          {% if section.settings.use_tn_model %}<img data-model-fullshot src="{{ 'tn-angle-1400.webp' | asset_url }}" srcset="{{ 'tn-angle-700.webp' | asset_url }} 700w, {{ 'tn-angle-1400.webp' | asset_url }} 1400w" sizes="(max-width: 700px) 92vw, 55vw" width="1400" height="1050" loading="lazy" alt="Blue and white TN — angle view rendered from the 3D model">{% else %}<img src="{{ 'stryde-concept-v2.png' | asset_url }}" width="1375" height="1144" loading="lazy" alt="{{ 'assets.concept_alt' | t | escape }}">{% endif %}
        </div>
        <div class="decon-crop" style="--zoom: {% if section.settings.use_tn_model %}1.25{% else %}1.35{% endif %}; --tx: 0%; --ty: 0%;">
          {% if section.settings.use_tn_model %}<img data-model-fullshot src="{{ 'tn-heel-1400.webp' | asset_url }}" srcset="{{ 'tn-heel-700.webp' | asset_url }} 700w, {{ 'tn-heel-1400.webp' | asset_url }} 1400w" sizes="(max-width: 700px) 92vw, 55vw" width="1400" height="1050" loading="lazy" alt="Blue and white TN — heel view rendered from the 3D model">{% else %}<img src="{{ 'stryde-concept-v2.png' | asset_url }}" width="1375" height="1144" loading="lazy" alt="" aria-hidden="true">{% endif %}
        </div>
        <div class="decon-crop" style="--zoom: {% if section.settings.use_tn_model %}1{% else %}1.2{% endif %}; --tx: 0%; --ty: 0%;">
          {% if section.settings.use_tn_model %}<img data-model-fullshot src="{{ 'tn-sole-1400.webp' | asset_url }}" srcset="{{ 'tn-sole-700.webp' | asset_url }} 700w, {{ 'tn-sole-1400.webp' | asset_url }} 1400w" sizes="(max-width: 700px) 92vw, 55vw" width="1400" height="1050" loading="lazy" alt="Blue and white TN — sole view rendered from the 3D model">{% else %}<img src="{{ 'stryde-concept-v2.png' | asset_url }}" width="1375" height="1144" loading="lazy" alt="" aria-hidden="true">{% endif %}
        </div>
        <span class="decon-tick" aria-hidden="true"></span>
        <span class="asset-tag">{% if section.settings.use_tn_model %}{{ 'hero.model_preview' | t }}{% else %}{{ 'assets.concept_tag' | t }}{% endif %}</span>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Deconstruction",
  "settings":[
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial images","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"02 — Anatomy"},
    {"type":"text","id":"heading_line_1","label":"Heading line one","default":"Anatomy of"},
    {"type":"text","id":"heading_line_2","label":"Heading line two","default":"a silhouette"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"One silhouette, five working parts. Walk the build from the woven upper down to the contact patch."},
    {"type":"text","id":"part_1_title","label":"Part 01 title","default":"Engineered upper"},
    {"type":"textarea","id":"part_1_body","label":"Part 01 body","default":"A breathable woven mesh shaped in one continuous pass, with reinforced stitching along every stress line."},
    {"type":"text","id":"part_2_title","label":"Part 02 title","default":"Support cage"},
    {"type":"textarea","id":"part_2_body","label":"Part 02 body","default":"A satin metal exoskeleton locks the midfoot without weighing it down."},
    {"type":"text","id":"part_3_title","label":"Part 03 title","default":"Midsole"},
    {"type":"textarea","id":"part_3_body","label":"Part 03 body","default":"Translucent cushioning chambers run the full length of the foot, tuned for rebound."},
    {"type":"text","id":"part_4_title","label":"Part 04 title","default":"Outsole"},
    {"type":"textarea","id":"part_4_body","label":"Part 04 body","default":"Sculpted traction in ice-clear polymer keeps the contact patch honest on any surface."},
    {"type":"text","id":"part_5_title","label":"Part 05 title","default":"Lacing"},
    {"type":"textarea","id":"part_5_body","label":"Part 05 body","default":"Flat woven laces through metal eyelets — a locked fit with no pressure points."}
  ],
  "presets":[{"name":"Deconstruction"}]
}
{% endschema %}
