<section class="page-shell cart-page"><div class="page-heading"><span class="micro">{{ 'cart.your_selection' | t }}</span><h1>{{ 'cart.title' | t }}<sup>{{ cart.item_count }}</sup></h1></div>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm">
      <div class="cart-layout"><div class="cart-items">{% for item in cart.items %}<article class="cart-item">
        <a class="cart-item-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', width: 180, alt: item.image.alt }}{% else %}<span class="micro">{{ 'products.image_unavailable' | t }}</span>{% endif %}</a>
        <div class="cart-item-info"><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign property_first_character = property.first | slice: 0 %}{% unless property.last == blank or property_first_character == '_' %}<p>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last | escape }}">{{ property.last | split: '/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endunless %}{% endfor %}<p>{{ item.final_price | money_with_currency }}</p>{% for discount in item.line_level_discount_allocations %}<p class="micro">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}<a class="text-link micro" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>
        <div class="cart-item-quantity"><label class="micro" for="Quantity-{{ item.index | plus: 1 }}">{{ 'products.quantity' | t }}</label><input class="quantity-input" id="Quantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" aria-label="{{ 'products.quantity' | t }} — {{ item.product.title | escape }}"><p>{{ item.final_line_price | money_with_currency }}</p></div>
      </article>{% endfor %}</div>
      <aside class="cart-summary"><h2>{{ 'cart.summary' | t }}</h2>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<p class="cart-total">{{ 'cart.subtotal' | t }} <span>{{ cart.total_price | money_with_currency }}</span></p><p class="micro">{{ 'cart.shipping_at_checkout' | t }}</p><button type="submit" name="update" class="button button-full">{{ 'cart.update' | t }}</button><button class="button button-dark button-full" name="checkout" type="submit">{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow' %}</button></aside></div>
    </form>
  {% else %}<div class="empty-state"><h2>{{ 'cart.empty' | t }}</h2><p>{{ 'cart.empty_description' | t }}</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">{{ 'general.explore_collection' | t }}{% render 'icon', name: 'arrow' %}</a></div>{% endif %}
</section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}

