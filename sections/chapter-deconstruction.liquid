{% liquid
  assign model_prefix = 'tn'
  assign model_label = 'Blue and white Air Max Plus / TN'
  assign middle_view = 'heel'
  if section.settings.use_drift_model
    assign model_prefix = 'tn-mono'
    assign model_label = 'White and black Air Max Plus Drift'
    assign middle_view = 'top'
  endif
%}
<section id="chapter-deconstruction" class="chapter chapter-surface chapter-deconstruction" {% if section.settings.use_tn_model %} data-tn-editorial{% endif %} data-chapter="deconstruction" data-env="deconstruction" data-section-id="{{ section.id }}" aria-labelledby="DeconHeading-{{ section.id }}">
  <div class="decon-grid">
    <div class="decon-list">
      <div class="decon-introduction">
  <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
  <h2 class="chapter-heading" id="DeconHeading-{{ section.id }}">
    <span class="heading-line"><span>{{ section.settings.heading_line_1 | escape }}</span></span>
    <span class="heading-line"><span>{{ section.settings.heading_line_2 | escape }}</span></span>
  </h2>
  <p class="chapter-intro">{{ section.settings.intro | escape }}</p>
      </div>
      {% for index in (1..5) %}
        {% case index %}
          {% when 1 %}{% assign title = section.settings.part_1_title %}{% assign body = section.settings.part_1_body %}
          {% when 2 %}{% assign title = section.settings.part_2_title %}{% assign body = section.settings.part_2_body %}
          {% when 3 %}{% assign title = section.settings.part_3_title %}{% assign body = section.settings.part_3_body %}
          {% when 4 %}{% assign title = section.settings.part_4_title %}{% assign body = section.settings.part_4_body %}
          {% when 5 %}{% assign title = section.settings.part_5_title %}{% assign body = section.settings.part_5_body %}
        {% endcase %}
        {% if title != blank %}
          <div class="decon-item" id="Anatomy-{{ section.id }}-{{ index }}">
            <span class="decon-num" aria-hidden="true">0{{ index }}</span>
            <div>
              <h3>{{ title | escape }}</h3>
              <p>{{ body | escape }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="decon-visual">
      <span class="decon-ghost" aria-hidden="true">02</span>
      <div class="frame decon-frame"{% if section.settings.use_tn_model and section.settings.use_drift_model %} data-journey-model="{{ 'nike-tn-monochrome.glb' | asset_url }}" data-journey-yaw="0" data-journey-variant="drift"{% endif %}>
        <div class="decon-crop is-active" style="--zoom: {% if section.settings.use_tn_model %}1.06{% else %}1.25{% endif %}; --tx: 0%; --ty: 0%;">
          {% if section.settings.use_tn_model %}<img data-model-fullshot src="{{ model_prefix | append: '-profile-2800.webp' | asset_url }}" srcset="{{ model_prefix | append: '-profile-1000.webp' | asset_url }} 1000w, {{ model_prefix | append: '-profile-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 55vw" width="2800" height="2100" loading="lazy" alt="{{ model_label }} — profile view rendered from the 3D model">{% else %}<img src="{{ 'stryde-concept-v2.png' | asset_url }}" width="1375" height="1144" loading="lazy" alt="{{ 'assets.concept_alt' | t | escape }}">{% endif %}
        </div>
        <div class="decon-crop" style="--zoom: {% if section.settings.use_drift_model %}1{% elsif section.settings.use_tn_model %}1.25{% else %}1.35{% endif %}; --tx: 0%; --ty: 0%;">
          {% if section.settings.use_tn_model %}<img data-model-fullshot src="{{ model_prefix | append: '-' | append: middle_view | append: '-2800.webp' | asset_url }}" srcset="{{ model_prefix | append: '-' | append: middle_view | append: '-1000.webp' | asset_url }} 1000w, {{ model_prefix | append: '-' | append: middle_view | append: '-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 55vw" width="2800" height="2100" loading="lazy" alt="{{ model_label }} — {% if section.settings.use_drift_model %}upper{% else %}heel{% endif %} view rendered from the 3D model">{% else %}<img src="{{ 'stryde-concept-v2.png' | asset_url }}" width="1375" height="1144" loading="lazy" alt="" aria-hidden="true">{% endif %}
        </div>
        <div class="decon-crop" style="--zoom: {% if section.settings.use_tn_model %}1{% else %}1.2{% endif %}; --tx: 0%; --ty: 0%;">
          {% if section.settings.use_tn_model %}<img data-model-fullshot src="{{ model_prefix | append: '-sole-2800.webp' | asset_url }}" srcset="{{ model_prefix | append: '-sole-1000.webp' | asset_url }} 1000w, {{ model_prefix | append: '-sole-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 55vw" width="2800" height="2100" loading="lazy" alt="{{ model_label }} — outsole view rendered from the 3D model">{% else %}<img src="{{ 'stryde-concept-v2.png' | asset_url }}" width="1375" height="1144" loading="lazy" alt="" aria-hidden="true">{% endif %}
        </div>
        <div class="decon-notes" aria-hidden="true">
          <span class="decon-note" data-decon-note><i>01</i>Upper and side structure</span>
          <span class="decon-note" data-decon-note><i>02</i>{% if section.settings.use_drift_model %}Upper and black lacing{% else %}Heel geometry and cage{% endif %}</span>
          <span class="decon-note" data-decon-note><i>03</i>Outsole and cushioning</span>
        </div>
        <span class="decon-tick" aria-hidden="true"></span>
        <span class="asset-tag">{% if section.settings.use_tn_model %}{{ 'hero.model_preview' | t }}{% else %}{{ 'assets.concept_tag' | t }}{% endif %}</span>
      </div>
      {% if section.settings.use_tn_model %}
      <dl class="chapter-ledger decon-ledger">
        <div><dt>Silhouette</dt><dd>{% if section.settings.use_drift_model %}Air Max Plus Drift{% else %}Air Max Plus / TN{% endif %}</dd></div>
        <div><dt>Color study</dt><dd>{% if section.settings.use_drift_model %}White / Black / Silver{% else %}Blue / White{% endif %}</dd></div>
        <div><dt>View sequence</dt><dd>Profile / {% if section.settings.use_drift_model %}Upper{% else %}Heel{% endif %} / Outsole</dd></div>
      </dl>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Deconstruction",
  "settings":[
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial images","default":false},
    {"type":"checkbox","id":"use_drift_model","label":"Show white and black Drift model","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"02 \u2014 Anatomy"},
    {"type":"text","id":"heading_line_1","label":"Heading line one","default":"Anatomy of"},
    {"type":"text","id":"heading_line_2","label":"Heading line two","default":"a silhouette"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"One silhouette, five working parts. Walk the build from the woven upper down to the contact patch."},
    {"type":"text","id":"part_1_title","label":"Part 01 title","default":"Upper"},
    {"type":"textarea","id":"part_1_body","label":"Part 01 body","default":"Follow the color and panel edges from the forefoot to the heel."},
    {"type":"text","id":"part_2_title","label":"Part 02 title","default":"Side structure"},
    {"type":"textarea","id":"part_2_body","label":"Part 02 body","default":"Curved ribs frame the panels beneath, defining the side profile."},
    {"type":"text","id":"part_3_title","label":"Part 03 title","default":"Midsole"},
    {"type":"textarea","id":"part_3_body","label":"Part 03 body","default":"A sculpted midsole connects the upper to the outsole."},
    {"type":"text","id":"part_4_title","label":"Part 04 title","default":"Outsole"},
    {"type":"textarea","id":"part_4_body","label":"Part 04 body","default":"View the tread and the shape of the arch from below."},
    {"type":"text","id":"part_5_title","label":"Part 05 title","default":"Lacing"},
    {"type":"textarea","id":"part_5_body","label":"Part 05 body","default":"Laces, eyelets and collar details complete the upper."}
  ],
  "presets":[{"name":"Deconstruction"}]
}
{% endschema %}
