{% comment %}Color-led editorial names describe the photographs, without claiming unverified brands or stock.{% endcomment %}
{% for index in (1..4) %}
  {% liquid
    case index
      when 1
        assign file = 'form-edit-sky.png'
        assign title = 'Sky blue / Gum'
        assign material = 'Suede & smooth panels'
        assign accent = '#527e9b'
      when 2
        assign file = 'form-edit-midnight.png'
        assign title = 'Midnight / Gum'
        assign material = 'Dark suede & smooth panels'
        assign accent = '#243b55'
      when 3
        assign file = 'form-edit-court.png'
        assign title = 'Navy / Ivory'
        assign material = 'Suede & contrasting details'
        assign accent = '#334564'
      when 4
        assign file = 'form-edit-charcoal.webp'
        assign title = 'Charcoal / Gum'
        assign material = 'Brown suede & charcoal panels'
        assign accent = '#716254'
    endcase
  %}
  <article class="form-look" data-form-look style="--look-accent: {{ accent }}" aria-labelledby="FormLook-{{ section_id }}-{{ index }}">
    <div class="form-look-art"><img src="{{ file | asset_url }}" width="1000" height="1000" loading="lazy" decoding="async" alt="{{ title | escape }} sneakers — {{ material | downcase | escape }}"></div>
    <div class="form-look-copy">
      <p class="form-look-index"><span>{{ material }}</span><span>0{{ index }} / 04</span></p>
      <h3 id="FormLook-{{ section_id }}-{{ index }}">{{ title }}</h3>
    </div>
  </article>
{% endfor %}
