{% liquid
  assign gallery_count = photos.size
  if native and gallery_count == 0 and selected_image != blank
    assign gallery_count = 1
  endif
  assign first_photo = photos.first
  if native
    assign first_src = selected_image | image_url: width: 1800
    assign first_alt = selected_image.alt | default: title
  else
    assign first_src = first_photo.src
    assign first_alt = title
  endif
%}
<div class="studio-gallery" id="Gallery-{{ gallery_id }}" data-product-gallery{% unless native %} data-gallery-normalize{% endunless %} aria-label="{{ title | escape }} photography">
  <figure class="studio-gallery-stage" data-product-media>
    {% if gallery_count > 0 %}
      <a class="studio-gallery-open" href="{{ first_src }}" data-gallery-open aria-label="Enlarge product image">
        <img src="{{ first_src }}" alt="{{ first_alt | escape }}" data-gallery-image loading="eager" fetchpriority="high" width="1200" height="1200">
        <span class="studio-gallery-zoom">{% render 'icon', name: 'plus' %}<span>Enlarge</span></span>
      </a>
      <figcaption class="studio-gallery-caption"><span data-gallery-caption>View 01</span><span class="studio-gallery-count" data-gallery-count aria-live="polite">01 / {{ gallery_count | prepend: '0' }}</span></figcaption>
      {% if gallery_count > 1 %}<div class="studio-gallery-controls"><button type="button" data-gallery-prev aria-label="Previous image">{% render 'icon', name: 'arrow' %}</button><button type="button" data-gallery-next aria-label="Next image">{% render 'icon', name: 'arrow' %}</button></div>{% endif %}
    {% else %}<p class="studio-no-image">{{ 'products.image_unavailable' | t }}</p>{% endif %}
  </figure>
  {% if photos.size > 1 %}
  <div class="studio-gallery-thumbnails" aria-label="Product views">
    {% for photo in photos %}
      {% liquid
        if native
          assign image_src = photo | image_url: width: 1800
          assign thumb_src = photo | image_url: width: 240
          assign photo_alt = photo.alt | default: title
        else
          assign image_src = photo.src
          assign thumb_src = photo.src
          assign photo_alt = title | append: ' — view ' | append: forloop.index
        endif
      %}
      <a class="studio-gallery-thumbnail" href="{{ image_src }}" data-product-thumbnail data-image-url="{{ image_src }}" data-image-alt="{{ photo_alt | escape }}" aria-label="View product image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
        <img src="{{ thumb_src }}" width="120" height="120" loading="lazy" alt=""><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
      </a>
    {% endfor %}
  </div>
  {% endif %}
  <p class="studio-gallery-help">{% if gallery_count > 1 %}{{ gallery_count }} views{% else %}One view{% endif %}<span>Click to explore the details</span></p>
  <dialog class="studio-lightbox" data-gallery-dialog aria-label="Product image viewer">
    <div class="studio-lightbox-toolbar"><span data-lightbox-count></span><button type="button" data-lightbox-zoom aria-label="Zoom image" aria-pressed="false">{% render 'icon', name: 'plus' %}<span>Zoom</span></button><button type="button" data-lightbox-close aria-label="Close image viewer">{% render 'icon', name: 'close' %}</button></div>
    <div class="studio-lightbox-canvas" data-lightbox-canvas>{% if gallery_count > 0 %}<img src="{{ first_src }}" data-lightbox-image width="1200" height="1200" alt="{{ first_alt | escape }}" draggable="false">{% endif %}</div>
    <div class="studio-lightbox-navigation"><button type="button" data-lightbox-prev aria-label="Previous image">{% render 'icon', name: 'arrow' %}</button><span>Use arrow keys to browse</span><button type="button" data-lightbox-next aria-label="Next image">{% render 'icon', name: 'arrow' %}</button></div>
  </dialog>
</div>
