<section id="chapter-technology" class="chapter chapter-dark chapter-technology" data-chapter="technology" data-env="technology" data-section-id="{{ section.id }}" aria-labelledby="TechHeading-{{ section.id }}">
  <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
  <h2 class="chapter-heading tech-heading" id="TechHeading-{{ section.id }}">
    {% assign tech_words = section.settings.heading | split: ' ' %}
    {% for word in tech_words %}
      <span class="heading-word"><span class="heading-word-inner">{{ word | upcase | escape }}</span></span>{% unless forloop.last %} {% endunless %}
    {% endfor %}
  </h2>
  {% if section.settings.outline_word != blank %}<p class="tech-word" aria-hidden="true" data-tech-word>{{ section.settings.outline_word | upcase | escape }}</p>{% endif %}
  {% if section.settings.brief != blank %}<p class="tech-brief">{{ section.settings.brief | escape }}</p>{% endif %}
  <div class="tech-stage">
    <figure class="tech-visual">
    {% assign technology_image = section.settings.image | default: section.settings.product.featured_image %}
    {% if technology_image != blank %}
      {{ technology_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700, 1200, 1800', sizes: '(max-width: 700px) 100vw, 60vw', alt: technology_image.alt }}
      {% if section.settings.image != blank and section.settings.image_is_concept %}<figcaption class="asset-tag">{{ 'assets.concept_tag' | t }}</figcaption>{% endif %}
    {% elsif section.settings.product != blank %}
      <p class="tech-image-pending">{{ 'hero.asset_pending' | t }}</p>
    {% elsif section.settings.use_tn_model %}
      <div class="tech-stack" data-tech-stack>
        <img class="tech-view is-active" data-tech-view="1" src="{{ 'tn-profile-2800.webp' | asset_url }}" srcset="{{ 'tn-profile-1000.webp' | asset_url }} 1000w, {{ 'tn-profile-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 100vw, 65vw" width="2800" height="2100" loading="eager" data-tech-model alt="Blue and white TN profile rendered from the 3D model">
        <img class="tech-view" data-tech-view="2" src="{{ 'tn-heel-2800.webp' | asset_url }}" srcset="{{ 'tn-heel-1000.webp' | asset_url }} 1000w, {{ 'tn-heel-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 100vw, 65vw" width="2800" height="2100" loading="lazy" alt="Blue and white TN heel study rendered from the 3D model">
        <img class="tech-view" data-tech-view="3" src="{{ 'tn-sole-2800.webp' | asset_url }}" srcset="{{ 'tn-sole-1000.webp' | asset_url }} 1000w, {{ 'tn-sole-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 100vw, 65vw" width="2800" height="2100" loading="lazy" alt="Blue and white TN outsole study rendered from the 3D model">
      </div>
      <figcaption class="asset-tag">{{ 'hero.model_preview' | t }}</figcaption>
    {% else %}
      {% render 'presentation-image', slot: 'featured' %}
    {% endif %}
  </figure>
  <div class="tech-rows" data-tech-rows>
    <span class="tech-spine" aria-hidden="true" data-tech-spine></span>
    <div class="tech-row">
      <span class="tech-num" aria-hidden="true">01</span>
      <h3>{{ section.settings.row_1_title | escape }}</h3>
      <p>{{ section.settings.row_1_body | escape }}</p>
    </div>
    <div class="tech-row">
      <span class="tech-num" aria-hidden="true">02</span>
      <h3>{{ section.settings.row_2_title | escape }}</h3>
      <p>{{ section.settings.row_2_body | escape }}</p>
    </div>
    <div class="tech-row">
      <span class="tech-num" aria-hidden="true">03</span>
      <h3>{{ section.settings.row_3_title | escape }}</h3>
      <p>{{ section.settings.row_3_body | escape }}</p>
    </div>
  </div>
  </div>
  <div class="chapter-summary tech-summary">
    <p>Read the form. Follow the details.</p>
    <a href="#chapter-materials">{{ 'general.materials' | t }} {% render 'icon', name: 'arrow-up' %}</a>
    <a href="#chapter-featured">{{ 'general.in_focus' | t }} {% render 'icon', name: 'arrow-up' %}</a>
  </div>
</section>
{% schema %}
{
  "name":"Technology",
  "settings":[
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial image","default":false},
    {"type":"product","id":"product","label":"Primary product","info":"Its image replaces the model study unless an image override is selected."},
    {"type":"image_picker","id":"image","label":"Editorial image"},
    {"type":"checkbox","id":"image_is_concept","label":"Editorial image is concept art","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"04 \u2014 Technology"},
    {"type":"text","id":"heading","label":"Heading","default":"Lines & layers"},
    {"type":"text","id":"outline_word","label":"Outlined background word"},
    {"type":"textarea","id":"brief","label":"Intro brief","default":"One silhouette, read three ways. Scroll the findings — the study turns with them."},
    {"type":"text","id":"row_1_title","label":"Row 01 title","default":"The profile"},
    {"type":"textarea","id":"row_1_body","label":"Row 01 body","default":"Follow the shape of the midsole and the way its curved surfaces catch the light."},
    {"type":"text","id":"row_2_title","label":"Row 02 title","default":"The layers"},
    {"type":"textarea","id":"row_2_body","label":"Row 02 body","default":"Layered lines frame the upper, giving the side profile its distinctive rhythm."},
    {"type":"text","id":"row_3_title","label":"Row 03 title","default":"The outsole"},
    {"type":"textarea","id":"row_3_body","label":"Row 03 body","default":"Turn the silhouette over to explore the tread, the arch and the contrast beneath."}
  ],
  "presets":[{"name":"Technology"}]
}
{% endschema %}
