{% capture footer_links %}
  {% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}
  {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
{% endcapture %}
{% assign footer_links = footer_links | strip %}
<footer class="site-footer">
  <a class="wordmark" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a>
  {% if footer_links != blank %}<nav class="footer-links" aria-label="{{ 'general.footer_navigation' | t }}">{{ footer_links }}</nav>{% endif %}
  <div class="footer-meta"><p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p><a href="#MainContent" class="back-top">{{ 'general.back_to_top' | t }} {% render 'icon', name: 'arrow-up' %}</a></div>
</footer>
{% schema %}
{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu"}]}
{% endschema %}
