<section class="page-shell auth-page" data-account-register>
  <div class="auth-panel">
    <header class="page-heading"><span class="micro">{{ shop.name | escape }}</span><h1>{{ 'customer.register_title' | t }}</h1></header>
    <p class="auth-intro">{{ 'customer.register_description' | t }}</p>
    {% form 'create_customer', novalidate: 'novalidate' %}
      {{ form.errors | default_errors }}
      <label for="RegisterFirstName">{{ 'customer.register_first_name' | t }}</label>
      <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
      <label for="RegisterLastName">{{ 'customer.register_last_name' | t }}</label>
      <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
      <label for="RegisterEmail">{{ 'customer.sign_in_email' | t }}</label>
      <input type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" required>
      <label for="RegisterPassword">{{ 'customer.sign_in_password' | t }}</label>
      <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" minlength="5" required>
      <button class="button button-dark button-full" type="submit">{{ 'customer.register_submit' | t }}</button>
    {% endform %}
    <p class="auth-switch micro">{{ 'customer.register_have_account' | t }} <a href="{{ routes.account_login_url }}">{{ 'customer.sign_in_submit' | t }}</a></p>
    <p class="auth-guest micro">{{ 'customer.sign_in_guest_note' | t }}</p>
  </div>
</section>
{% schema %}{"name":"Customer register","settings":[]}{% endschema %}
