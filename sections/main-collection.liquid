{% liquid
  assign photography_references = false
  if collection.products_count == 0 and section.preview_reference_mode
    assign photography_references = true
  endif
%}
<section class="page-shell collection-page collection-studio{% if photography_references %} collection-page-photography{% endif %}" data-listing-section data-section-id="{{ section.id }}">
  {% if section.preview_photo_shop.size > 0 %}
    <header class="listing-heading photo-shop-heading studio-heading" data-listing-heading>
      <h1>The collection.</h1>
      <div class="studio-heading-note"><p>Footwear, from every perspective.</p><p class="listing-preview-note">Photo studies · Purchases unavailable</p></div>
    </header>
    {% render 'photo-shop-catalog', state: section.preview_photo_state, payload: section.preview_photo_payload %}
  {% elsif photography_references %}
    <header class="listing-heading" data-listing-heading>
      <div><h1>The collection.</h1></div>
      <div class="listing-introduction"><p>Independent footwear photography.</p><p class="listing-preview-note">Photo studies · Purchases unavailable</p></div>
    </header>
    {% render 'photography-catalog', catalog: section.preview_photography %}
  {% else %}
  <div class="page-heading listing-heading studio-heading" data-listing-heading><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte collection-description">{{ collection.description }}</div>{% endif %}</div>
  {% paginate collection.products by 12 %}
    <form method="get" action="{{ collection.url }}" class="collection-controls">
      <div class="filter-groups">
        {% for filter in collection.filters %}
          <details class="filter"><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary><div class="filter-panel">
            {% case filter.type %}
              {% when 'boolean', 'list' %}{% for value in filter.values %}<label class="filter-value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>{{ value.label | escape }} <span>({{ value.count }})</span></label>{% endfor %}
              {% when 'price_range' %}<div class="price-filter"><label for="PriceMin-{{ section.id }}">{{ 'collection.min_price' | t }} ({{ cart.currency.iso_code }})</label><input type="number" name="{{ filter.min_value.param_name }}" id="PriceMin-{{ section.id }}" min="0" step="0.01"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}><label for="PriceMax-{{ section.id }}">{{ 'collection.max_price' | t }} ({{ cart.currency.iso_code }})</label><input type="number" name="{{ filter.max_value.param_name }}" id="PriceMax-{{ section.id }}" min="0" step="0.01" placeholder="{{ filter.range_max | divided_by: 100.0 }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></div>
            {% endcase %}
          </div></details>
        {% endfor %}
      </div>
      <div class="sort-controls"><label class="micro" for="SortBy">{{ 'collection.sort' | t }}</label><select name="sort_by" id="SortBy">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button class="button button-small" type="submit">{{ 'collection.apply' | t }}</button></div>
    </form>
    <div class="active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">×</span><span class="sr-only">{{ 'collection.remove_filter' | t }}</span></a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != null or filter.max_value.value != null %}<a href="{{ filter.url_to_remove }}">{{ filter.label | escape }} <span aria-hidden="true">×</span><span class="sr-only">{{ 'collection.remove_filter' | t }}</span></a>{% endif %}{% endif %}{% endfor %}</div>
    <div class="collection-count micro">{{ 'collection.product_count' | t: count: collection.products_count }}</div>
    <div class="product-grid">{% for product in collection.products %}{% render 'product-card', card_product: product %}{% else %}<div class="empty-state"><h2>{{ 'collection.empty' | t }}</h2><p>{{ 'collection.empty_description' | t }}</p><a class="text-link" href="{{ collection.url }}">{{ 'collection.clear' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% endfor %}</div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
  {% endif %}
</section>
{% schema %}
{"name":"Collection","settings":[]}
{% endschema %}
