<section class="page-shell search-page" data-listing-section data-predictive-root><div class="page-heading"><h1>{{ 'general.search' | t | upcase }}</h1></div><form method="get" action="{{ routes.search_url }}" role="search" class="search-form" data-predictive-form data-predictive-url="{{ routes.predictive_search_url }}">{% render 'collection-search-field', search_id: 'SearchInput', search_value: search.terms %}<input type="hidden" name="options[prefix]" value="last"><span class="sr-only" data-predictive-label>{{ 'search.label' | t }}</span><span class="sr-only" data-predictive-error>{{ 'search.predictive_error' | t }}</span></form>
{% if section.preview_search_photography.size > 0 %}
  <div class="search-reference-note"><p class="micro">{{ 'search.results_for' | t }} “{{ search.terms | escape }}”</p><p>Development photography · Not store inventory or available for purchase</p></div>
  {% render 'photography-catalog', catalog: section.preview_search_photography %}
{% elsif search.performed %}{% paginate search.results by 12 %}<p class="micro search-count">{% assign escaped_terms = search.terms | escape %}{{ 'search.results_count' | t: count: search.results_count, terms: escaped_terms }}</p><div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', card_product: result %}{% else %}<article class="search-content"><span class="micro">{{ result.object_type | escape }}</span><h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2><p>{{ result.content | strip_html | truncatewords: 30 }}</p></article>{% endif %}{% else %}<div class="empty-state"><h2>{{ 'search.empty' | t }}</h2><p>{{ 'search.empty_description' | t }}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'general.explore_collection' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% else %}<div class="search-suggestions"><p class="micro">{{ 'search.suggestions' | t }}</p><a href="{{ routes.search_url }}?q=Nike">Nike {% render 'icon', name: 'arrow' %}</a><a href="{{ routes.search_url }}?q=Adidas">Adidas {% render 'icon', name: 'arrow' %}</a><a href="{{ routes.search_url }}?q=New+Balance">New Balance {% render 'icon', name: 'arrow' %}</a></div>{% endif %}</section>
{% schema %}
{"name":"Search","settings":[]}
{% endschema %}
