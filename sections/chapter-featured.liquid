{% liquid
  assign product = section.settings.product
  assign selected_variant = product.selected_or_first_available_variant
  assign presentation_image = section.settings.image | default: product.featured_image
  assign featured_prefix = 'tn'
  assign featured_label = 'Blue and white TN'
  if section.settings.use_navy_model
    assign featured_prefix = 'tn-navy'
    assign featured_label = 'Deep blue and navy Air Max Plus'
  endif
%}
<section id="chapter-featured" class="chapter chapter-surface chapter-featured" {% if section.settings.use_tn_model %} data-tn-editorial{% endif %} data-chapter="featured" data-env="featured" data-section-id="{{ section.id }}" aria-labelledby="FeatHeading-{{ section.id }}">
  {% if section.settings.outline_word != blank %}<p class="feat-word" aria-hidden="true" data-feat-word>{{ section.settings.outline_word | upcase | escape }}</p>{% endif %}
  <div class="feat-grid">
    <div class="frame feat-frame"{% if section.settings.use_tn_model and section.settings.use_navy_model and product == blank and presentation_image == blank %} data-journey-model="{{ 'nike-tn-deep-blue.glb' | asset_url }}" data-journey-yaw="0" data-journey-variant="navy" data-journey-from-primary data-journey-change-start="0.15" data-journey-change-end="0.85"{% endif %}>
      {% if product != blank and presentation_image == blank %}
        <p class="editorial-image-pending">{{ 'hero.asset_pending' | t }}</p>
      {% elsif section.settings.use_tn_model and presentation_image == blank %}
        <img src="{{ featured_prefix | append: '-angle-2800.webp' | asset_url }}" srcset="{{ featured_prefix | append: '-angle-1000.webp' | asset_url }} 1000w, {{ featured_prefix | append: '-angle-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 55vw" width="2800" height="2100" loading="lazy" data-featured-model alt="{{ featured_label }} — angle view rendered from the 3D model">
        <span class="asset-tag">{{ 'hero.model_preview' | t }}</span>
      {% else %}
      {% assign supplied_concept = false %}
      {% if section.settings.image != blank %}{% assign supplied_concept = section.settings.image_is_concept %}{% endif %}
      {% render 'presentation-image', slot: 'featured', image: presentation_image, image_is_concept: supplied_concept %}
      {% endif %}
    </div>
    <div class="feat-copy">
      <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="feat-title" id="FeatHeading-{{ section.id }}">
        <span class="heading-line"><span>{% if product != blank %}{{ product.title | upcase | escape }}{% else %}{{ section.settings.fallback_title | upcase | escape }}{% endif %}</span></span>
      </h2>
      {% if product != blank %}
        <p class="feat-price"><span data-feat-price>{{ selected_variant.price | money_with_currency }}</span>{% if selected_variant.compare_at_price > selected_variant.price %}<s>{{ selected_variant.compare_at_price | money_with_currency }}</s>{% endif %}</p>
      {% endif %}
      <p class="feat-story">{{ section.settings.story | escape }}</p>
      {% assign feat_specs = section.settings.specs | split: ',' %}
      {% if feat_specs.size > 0 %}
      <ul class="feat-specs" aria-label="{{ 'materials.specs_label' | t | escape }}">
        {% for spec in feat_specs %}{% if spec != blank %}<li>{{ spec | strip | escape }}</li>{% endif %}{% endfor %}
      </ul>
      {% endif %}
      {% assign feat_details = section.settings.details | split: '|' %}
      {% if feat_details.size > 0 %}
      <ul class="feat-notes" aria-label="{{ 'featured.details_label' | t | escape }}">
        {% for detail in feat_details %}
          {% assign label = detail | split: ':' | first | strip %}
          {% assign value = detail | split: ':' | last | strip %}
          {% if label != blank and value != blank %}
          <li><i>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</i><b>{{ label | escape }}</b><span>{{ value | escape }}</span></li>
          {% endif %}
        {% endfor %}
      </ul>
      {% endif %}
      <div class="feat-actions">
        {% if product != blank %}
          {% form 'product', product, class: 'feat-form' %}
            <div class="hero-form-errors">{{ form.errors | default_errors }}</div>
            {% unless product.has_only_default_variant %}
              <label class="sr-only" for="FeatVariant-{{ section.id }}">{{ 'products.choose_variant' | t }}</label>
              <select id="FeatVariant-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}"{% if variant == selected_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}</option>
                {% endfor %}
              </select>
            {% else %}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
            {% endunless %}
            <button class="hero-cart" type="submit" name="add"{% unless selected_variant.available %} disabled{% endunless %}>{% if selected_variant.available %}{{ 'hero.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>
          {% endform %}
          <a class="hero-details" href="{{ product.url }}">{{ 'hero.details' | t }}</a>
        {% else %}
          <a class="hero-cart" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.fallback_cta | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Featured product",
  "settings":[
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial images","default":false},
    {"type":"checkbox","id":"use_navy_model","label":"Use supplied deep blue TN model","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"06 \u2014 Featured"},
    {"type":"text","id":"outline_word","label":"Outlined background word","default":"In focus"},
    {"type":"product","id":"product","label":"Featured product"},
    {"type":"collection","id":"collection","label":"Fallback collection link"},
    {"type":"text","id":"fallback_title","label":"Fallback title","default":"Blue / white."},
    {"type":"textarea","id":"story","label":"Story","default":"A blue upper framed by white waves. The dark outsole gives the light silhouette a distinct edge."},
    {"type":"text","id":"specs","label":"Spec chips","default":"Gradient upper, Wave cage, Woven collar"},
    {"type":"text","id":"details","label":"Detail ledger (pipe-separated, Label: Value)","default":"Colourway: Blue / White | Upper: Gradient knit with wave cage | Sole: Dark tread, sculpted midsole"},
    {"type":"text","id":"fallback_cta","label":"Fallback call to action","default":"View the collection"},
    {"type":"image_picker","id":"image","label":"Presentation image","info":"Replaces the product or concept image. Leave empty to use the assigned product photo, then labeled concept art."},
    {"type":"checkbox","id":"image_is_concept","label":"Presentation image is concept art","default":false}
  ],
  "presets":[{"name":"Featured product"}]
}
{% endschema %}
