<section class="page-shell search-page"><div class="page-heading"><h1>{{ 'general.search' | t | upcase }}</h1></div><form method="get" action="{{ routes.search_url }}" role="search" class="search-form"><label for="SearchInput" class="sr-only">{{ 'search.label' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"><input type="hidden" name="options[prefix]" value="last"><button class="button button-dark" type="submit">{{ 'general.search' | t }} {% render 'icon', name: 'search' %}</button></form>
{% if search.performed %}{% paginate search.results by 12 %}<p class="micro search-count">{{ search.results_count }} {{ 'search.results_for' | t }} “{{ search.terms | escape }}”</p><div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', card_product: result %}{% else %}<article class="search-content"><span class="micro">{{ result.object_type | escape }}</span><h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2><p>{{ result.content | strip_html | truncatewords: 30 }}</p></article>{% endif %}{% else %}<div class="empty-state"><h2>{{ 'search.empty' | t }}</h2><p>{{ 'search.empty_description' | t }}</p></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
