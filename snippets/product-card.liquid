<article class="product-card">
  <a class="product-card-media" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
    {% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 900px) 30vw, (min-width: 600px) 45vw, 90vw', alt: card_product.featured_image.alt }}{% else %}<span class="micro">{{ 'products.image_unavailable' | t }}</span>{% endif %}
  </a>
  <div class="product-card-info"><h2><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h2><p>{% if card_product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ card_product.price | money_with_currency }}</p>{% unless card_product.available %}<p class="product-card-status">{{ 'products.sold_out' | t }}</p>{% endunless %}</div>
</article>
