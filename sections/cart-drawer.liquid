{% comment %}
  Slide-over bag. Rendered on every page and refreshed through the Section
  Rendering API (?sections=cart-drawer), so Shopify formats every price,
  discount and translation. The <dialog> element gives focus containment and
  Escape handling natively; quantity and removal are delegated from the dialog
  itself so re-rendered rows keep working without rebinding.
{% endcomment %}
<dialog class="cart-drawer" data-cart-drawer aria-label="{{ 'cart.drawer_title' | t }}">
  {% capture drawer_content %}
    <div class="cart-drawer-scroll" data-lenis-prevent>
      <header class="cart-drawer-header">
        <h2>{{ 'cart.drawer_title' | t }}<sup data-cart-count>{{ cart.item_count }}</sup></h2>
        <button type="button" class="cart-drawer-close" data-cart-close aria-label="{{ 'cart.drawer_close' | t }}">{% render 'icon', name: 'close' %}</button>
      </header>
      {% if cart.item_count > 0 %}
        <div class="cart-drawer-items">
          {% for item in cart.items %}
            <article class="cart-drawer-item" data-cart-item data-key="{{ item.key }}">
              <a class="cart-drawer-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', width: 120, alt: item.image.alt | default: item.product.title | escape }}
                {% else %}<span class="micro">{{ 'products.image_unavailable' | t }}</span>{% endif %}
              </a>
              <div class="cart-drawer-info">
                <h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                {% unless item.product.has_only_default_variant %}<p class="micro">{{ item.variant.title | escape }}</p>{% endunless %}
                {% for discount in item.line_level_discount_allocations %}<p class="micro cart-drawer-discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}
                <div class="cart-drawer-line">
                  <div class="cart-drawer-quantity">
                    <button type="button" data-cart-quantity data-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t }} — {{ item.product.title | escape }}">&#8722;</button>
                    <span data-cart-quantity-value aria-live="polite">{{ item.quantity }}</span>
                    <button type="button" data-cart-quantity data-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t }} — {{ item.product.title | escape }}">+</button>
                  </div>
                  <p class="cart-drawer-price">{{ item.final_line_price | money_with_currency }}</p>
                </div>
                <button type="button" class="text-link micro" data-cart-remove data-key="{{ item.key }}" aria-label="{{ 'cart.remove' | t }} — {{ item.product.title | escape }}">{{ 'cart.remove' | t }}</button>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="cart-drawer-empty">
          <p>{{ 'cart.empty' | t }}</p>
          <p class="micro">{{ 'cart.empty_description' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}" data-cart-close-link>{{ 'cart.continue_shopping' | t }} {% render 'icon', name: 'arrow' %}</a>
        </div>
      {% endif %}
    </div>
    <footer class="cart-drawer-footer">
      {% liquid
        assign free_shipping_threshold = section.settings.free_shipping_threshold | times: 100
      %}
      {% if free_shipping_threshold > 0 %}
        {% liquid
          assign free_shipping_remaining = free_shipping_threshold | minus: cart.total_price
          assign free_shipping_money = free_shipping_remaining | money
        %}
        <div class="cart-shipping" data-free-shipping>
          {% if free_shipping_remaining > 0 %}
            <p class="micro">{{ 'cart.free_shipping_progress' | t: remaining: free_shipping_money }}</p>
          {% else %}
            <p class="micro cart-shipping-reached">{{ 'cart.free_shipping_reached' | t }}</p>
          {% endif %}
          <div class="cart-shipping-track"><div class="cart-shipping-fill" style="width: {% if cart.total_price >= free_shipping_threshold %}100{% else %}{{ cart.total_price | times: 100.0 | divided_by: free_shipping_threshold | at_most: 100 }}{% endif %}%"></div></div>
        </div>
      {% endif %}
      {% if cart.item_count > 0 %}
        {% for discount in cart.cart_level_discount_applications %}<p class="cart-drawer-discounts micro">{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}
        <p class="cart-drawer-subtotal">{{ 'cart.subtotal' | t }} <span data-cart-subtotal>{{ cart.total_price | money_with_currency }}</span></p>
        <p class="micro cart-drawer-note">{{ 'cart.shipping_at_checkout' | t }}</p>
        <a class="button button-dark button-full" href="{{ routes.checkout_url }}" data-cart-checkout>{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</a>
        <div class="cart-dev-checkout" data-dev-checkout hidden>
          <p class="micro">{{ 'cart.free_shipping_note' | t }}</p>
          <p class="cart-dev-label micro">DEVELOPMENT PREVIEW · CHECKOUT &amp; PAYMENTS REQUIRE A CONNECTED SHOPIFY STORE · NO ORDER IS CREATED</p>
        </div>
        <a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.view_bag' | t }} {% render 'icon', name: 'arrow' %}</a>
      {% endif %}
    </footer>
  {% endcapture %}
  <div class="cart-drawer-content" data-cart-drawer-content>{{ drawer_content }}</div>
</dialog>
<script type="application/json" data-cart-config>{"routes":{"root":{{ routes.root_url | json }},"cart":{{ routes.cart_url | json }},"cartAdd":{{ routes.cart_add_url | append: '.js' | json }},"cartChange":{{ routes.cart_change_url | append: '.js' | json }},"cartFetch":{{ routes.cart_url | append: '.js' | json }},"checkout":{{ routes.checkout_url | json }}}}</script>
{% schema %}
{"name":"Cart drawer","settings":[{"type":"number","id":"free_shipping_threshold","label":"Free shipping threshold","info":"Store currency amount that unlocks free shipping, for example 300. Leave blank to hide the progress bar. The rate itself is configured in Shopify Admin shipping settings."}]}
{% endschema %}
