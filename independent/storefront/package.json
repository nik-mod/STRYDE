{
  "name": "stryde-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node ../scripts/build-motion.mjs",
    "dev": "npm run assets && next dev --hostname 127.0.0.1 --port 3000",
    "build": "npm run assets && next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
