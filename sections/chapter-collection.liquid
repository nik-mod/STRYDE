{% liquid
  assign collection = section.settings.collection
  assign has_products = false
  if collection != blank and collection.products_count > 0
    assign has_products = true
  endif
  assign field_1 = section.settings.field_1 | default: '#41b4f0'
  assign field_2 = section.settings.field_2 | default: '#7fa9f6'
  assign field_3 = section.settings.field_3 | default: '#4fc4d4'
%}
<section id="chapter-collection" class="chapter chapter-paper chapter-collection" {% if section.settings.use_tn_model %} data-tn-editorial{% endif %} data-chapter="collection" data-env="collection" data-section-id="{{ section.id }}" aria-labelledby="CollHeading-{{ section.id }}">
  <div class="coll-head">
    <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
    <h2 class="chapter-heading" id="CollHeading-{{ section.id }}">
      <span class="heading-line"><span>{{ section.settings.heading | upcase | escape }}</span></span>
    </h2>
    {% if has_products %}<p class="coll-count">{{ collection.products_count }} {{ 'collection.products' | t }}</p>{% endif %}
  </div>
  <div class="coll-stage" data-coll-stage>
    {% if has_products %}
      {% for product in collection.products limit: 3 %}
        <article class="coll-scene" data-coll-scene style="--scene-field: {% cycle field_1, field_2, field_3 %}">
          <span class="coll-scene-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="coll-scene-art">
            <a class="coll-scene-figure" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              <span class="coll-scene-visual" data-coll-visual>
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 900px) 56vw, 92vw', alt: product.featured_image.alt }}
                {% else %}
                  <span class="coll-image-pending">{{ 'hero.asset_pending' | t }}</span>
                {% endif %}
              </span>
            </a>
          </div>
          <div class="coll-scene-copy">
            <h3 class="coll-scene-name"><span class="scene-line"><span><a href="{{ product.url }}">{{ product.title | escape }}</a></span></span></h3>
            <p class="coll-scene-price">{% if product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ product.price | money_with_currency }}</p>
            {% if product.available %}<a class="coll-scene-link" href="{{ product.url }}">{{ 'hero.details' | t }}</a>{% else %}<p class="coll-scene-link">{{ 'products.sold_out' | t }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% for index in (1..3) %}
        {% liquid
          assign image_key = 'scene_' | append: index | append: '_image'
          assign concept_key = image_key | append: '_is_concept'
          assign image_slot = 'collection_' | append: index
        %}
        {% case index %}{% when 1 %}{% assign tn_view = 'tn-angle-1400.webp' %}{% assign tn_title = 'The first impression.' %}{% when 2 %}{% assign tn_view = 'tn-heel-1400.webp' %}{% assign tn_title = 'A change of direction.' %}{% when 3 %}{% assign tn_view = 'tn-top-1400.webp' %}{% assign tn_title = 'From another point of view.' %}{% endcase %}
        <article class="coll-scene" data-coll-scene style="--scene-field: {% cycle field_1, field_2, field_3 %}">
          <span class="coll-scene-num" aria-hidden="true">0{{ index }}</span>
          <div class="coll-scene-art">
            <div class="coll-scene-figure">
              {% assign use_tn_view = false %}
              {% if section.settings.use_tn_model and section.settings[image_key] == blank %}{% assign use_tn_view = true %}{% endif %}
              <span class="coll-scene-visual" data-coll-visual>
                {% if use_tn_view %}
                  <img data-model-editorial-image src="{{ tn_view | asset_url }}" srcset="{{ tn_view | replace: '-1400.webp', '-700.webp' | asset_url }} 700w, {{ tn_view | asset_url }} 1400w" sizes="(min-width: 900px) 56vw, 92vw" width="1400" height="1050" loading="lazy" alt="Blue and white TN — {{ tn_title | escape }} 3D model preview">
                  <span class="asset-tag">{{ 'hero.model_preview' | t }}</span>
                {% else %}
                  {% render 'presentation-image', slot: image_slot, image: section.settings[image_key], image_is_concept: section.settings[concept_key], sizes: '(min-width: 900px) 56vw, 92vw' %}
                {% endif %}
              </span>
            </div>
          </div>
          <div class="coll-scene-copy">
            <h3 class="coll-scene-name"><span class="scene-line"><span>{% if use_tn_view %}{{ tn_title | escape }}{% else %}{{ section.settings.tile_title | escape }} 0{{ index }}{% endif %}</span></span></h3>
            <p class="coll-scene-price">{% if use_tn_view %}{{ 'hero.perspective_study' | t }}{% else %}{{ 'hero.concept_tile_price' | t }}{% endif %}</p>
            <a class="coll-scene-link" href="{{ routes.all_products_collection_url }}">{{ 'general.collection' | t }}</a>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Collection reveal",
  "settings":[
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial images","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"05 — The collection"},
    {"type":"text","id":"heading","label":"Heading","default":"The lineup"},
    {"type":"collection","id":"collection","label":"Collection","info":"The first three products play as a cinematic sequence. Without a collection, labeled concept studies stand in."},
    {"type":"color","id":"field_1","label":"Product 01 field","default":"#41b4f0"},
    {"type":"color","id":"field_2","label":"Product 02 field","default":"#7fa9f6"},
    {"type":"color","id":"field_3","label":"Product 03 field","default":"#4fc4d4"},
    {"type":"text","id":"tile_title","label":"Concept tile title","default":"Concept"},
    {"type":"header","content":"Standalone scene images"},
    {"type":"paragraph","content":"Used only without an assigned collection. Assigned products always use their own images. Empty slots show labeled temporary artwork."},
    {"type":"image_picker","id":"scene_1_image","label":"Scene 01 image"},
    {"type":"checkbox","id":"scene_1_image_is_concept","label":"Scene 01 image is concept art","default":false},
    {"type":"image_picker","id":"scene_2_image","label":"Scene 02 image"},
    {"type":"checkbox","id":"scene_2_image_is_concept","label":"Scene 02 image is concept art","default":false},
    {"type":"image_picker","id":"scene_3_image","label":"Scene 03 image"},
    {"type":"checkbox","id":"scene_3_image_is_concept","label":"Scene 03 image is concept art","default":false}
  ],
  "presets":[{"name":"Collection reveal"}]
}
{% endschema %}
