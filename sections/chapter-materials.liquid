<section id="chapter-materials" class="chapter chapter-paper chapter-materials" {% if section.settings.use_tn_model %} data-tn-editorial{% endif %} data-chapter="materials" data-env="materials" data-section-id="{{ section.id }}" aria-labelledby="MatHeading-{{ section.id }}">
  <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
  <h2 class="chapter-heading" id="MatHeading-{{ section.id }}">
    <span class="heading-line"><span>{{ section.settings.heading | escape }}</span></span>
  </h2>
  <div class="mat-panels" data-mat-panels>
    <div class="mat-panel mat-panel-upper">
      <div class="mat-media">
        <span class="mat-ghost" aria-hidden="true">01</span>
        <div class="frame mat-frame">
          {% if section.settings.use_tn_model and section.settings.panel_1_image == blank %}
            <img src="{{ 'tn-angle-2800.webp' | asset_url }}" srcset="{{ 'tn-angle-1000.webp' | asset_url }} 1000w, {{ 'tn-angle-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 46vw" width="2800" height="2100" loading="lazy" data-macro-image style="--zoom: 1; --tx: 0%; --ty: 0%;" alt="Three-quarter view of the blue gradient upper and white wave cage, rendered from the TN model">
            <span class="asset-tag">{{ 'hero.model_preview' | t }}</span>
          {% else %}
          {% render 'presentation-image', slot: 'material_1', image: section.settings.panel_1_image, image_is_concept: section.settings.panel_1_image_is_concept, crop_style: '--zoom: 2.9; --tx: 12%; --ty: -18%;' %}
          {% endif %}
        </div>
        {% if section.settings.use_tn_model and section.settings.panel_1_image == blank %}
        <figure class="mat-inset" aria-hidden="true" data-mat-inset>
          <img src="{{ 'tn-detail-2800.webp' | asset_url }}" srcset="{{ 'tn-detail-1000.webp' | asset_url }} 1000w, {{ 'tn-detail-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 34vw, 300px" width="2800" height="2100" loading="lazy" alt="">
        </figure>
        {% endif %}
      </div>
      <div class="mat-copy">
        <p class="mat-index">01 / Color</p>
        <h3>{{ section.settings.panel_1_title | escape }}</h3>
        <p>{{ section.settings.panel_1_body | escape }}</p>
        {% assign panel_1_specs = section.settings.panel_1_specs | split: ',' %}
        {% if panel_1_specs.size > 0 %}
        <ul class="mat-specs" aria-label="{{ 'materials.specs_label' | t | escape }}">
          {% for spec in panel_1_specs %}{% if spec != blank %}<li>{{ spec | strip | escape }}</li>{% endif %}{% endfor %}
        </ul>
        {% endif %}
        <div class="mat-rule" aria-hidden="true"></div>
      </div>
    </div>
    <div class="mat-panel mat-panel-cage">
      <div class="mat-media">
        <span class="mat-ghost" aria-hidden="true">02</span>
        <div class="frame mat-frame">
          {% if section.settings.use_tn_model and section.settings.panel_2_image == blank %}
            <img src="{{ 'tn-profile-2800.webp' | asset_url }}" srcset="{{ 'tn-profile-1000.webp' | asset_url }} 1000w, {{ 'tn-profile-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 46vw" width="2800" height="2100" loading="lazy" data-macro-image style="--zoom: 1; --tx: 0%; --ty: 0%;" alt="Side profile of the white wave cage and sculpted midsole, rendered from the TN model">
            <span class="asset-tag">{{ 'hero.model_preview' | t }}</span>
          {% else %}
          {% render 'presentation-image', slot: 'material_2', image: section.settings.panel_2_image, image_is_concept: section.settings.panel_2_image_is_concept, crop_style: '--zoom: 1; --tx: 0%; --ty: 0%;' %}
          {% endif %}
        </div>
        {% if section.settings.use_tn_model and section.settings.panel_2_image == blank %}
        <figure class="mat-inset" aria-hidden="true" data-mat-inset>
          <img src="{{ 'tn-top-2800.webp' | asset_url }}" srcset="{{ 'tn-top-1000.webp' | asset_url }} 1000w, {{ 'tn-top-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 34vw, 300px" width="2800" height="2100" loading="lazy" alt="">
        </figure>
        {% endif %}
      </div>
      <div class="mat-copy">
        <p class="mat-index">02 / Structure</p>
        <h3>{{ section.settings.panel_2_title | escape }}</h3>
        <p>{{ section.settings.panel_2_body | escape }}</p>
        {% assign panel_2_specs = section.settings.panel_2_specs | split: ',' %}
        {% if panel_2_specs.size > 0 %}
        <ul class="mat-specs" aria-label="{{ 'materials.specs_label' | t | escape }}">
          {% for spec in panel_2_specs %}{% if spec != blank %}<li>{{ spec | strip | escape }}</li>{% endif %}{% endfor %}
        </ul>
        {% endif %}
        <div class="mat-rule" aria-hidden="true"></div>
      </div>
    </div>
    <div class="mat-panel mat-panel-sole">
      <div class="mat-media">
        <span class="mat-ghost" aria-hidden="true">03</span>
        <div class="frame mat-frame">
          {% if section.settings.use_tn_model and section.settings.panel_3_image == blank %}
            <img src="{{ 'tn-sole-2800.webp' | asset_url }}" srcset="{{ 'tn-sole-1000.webp' | asset_url }} 1000w, {{ 'tn-sole-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 92vw, 46vw" width="2800" height="2100" loading="lazy" data-macro-image style="--zoom: 1; --tx: 0%; --ty: 0%;" alt="Underside view of the dark tread and blue arch, rendered from the TN model">
            <span class="asset-tag">{{ 'hero.model_preview' | t }}</span>
          {% else %}
          {% render 'presentation-image', slot: 'material_3', image: section.settings.panel_3_image, image_is_concept: section.settings.panel_3_image_is_concept, crop_style: '--zoom: 2.5; --tx: -70%; --ty: -10%;' %}
          {% endif %}
        </div>
        {% if section.settings.use_tn_model and section.settings.panel_3_image == blank %}
        <figure class="mat-inset" aria-hidden="true" data-mat-inset>
          <img src="{{ 'tn-heel-2800.webp' | asset_url }}" srcset="{{ 'tn-heel-1000.webp' | asset_url }} 1000w, {{ 'tn-heel-2800.webp' | asset_url }} 2800w" sizes="(max-width: 700px) 34vw, 300px" width="2800" height="2100" loading="lazy" alt="">
        </figure>
        {% endif %}
      </div>
      <div class="mat-copy">
        <p class="mat-index">03 / Foundation</p>
        <h3>{{ section.settings.panel_3_title | escape }}</h3>
        <p>{{ section.settings.panel_3_body | escape }}</p>
        {% assign panel_3_specs = section.settings.panel_3_specs | split: ',' %}
        {% if panel_3_specs.size > 0 %}
        <ul class="mat-specs" aria-label="{{ 'materials.specs_label' | t | escape }}">
          {% for spec in panel_3_specs %}{% if spec != blank %}<li>{{ spec | strip | escape }}</li>{% endif %}{% endfor %}
        </ul>
        {% endif %}
        <div class="mat-rule" aria-hidden="true"></div>
      </div>
    </div>
  </div>
  <ol class="mat-rail" data-mat-rail aria-hidden="true">
    <li class="is-active"><i>01</i><em>Color</em></li>
    <li><i>02</i><em>Structure</em></li>
    <li><i>03</i><em>Foundation</em></li>
  </ol>
</section>
{% schema %}
{
  "name":"Materials",
  "settings":[
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial images","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"03 \u2014 Materials"},
    {"type":"text","id":"heading","label":"Heading","default":"In detail"},
    {"type":"text","id":"panel_1_title","label":"Panel 01 title","default":"Color and texture"},
    {"type":"textarea","id":"panel_1_body","label":"Panel 01 body","default":"A close view of the surface, where light brings the color and texture into focus."},
    {"type":"text","id":"panel_1_specs","label":"Panel 01 spec chips","default":"Gradient knit, Wave cage, Woven collar"},
    {"type":"text","id":"panel_2_title","label":"Panel 02 title","default":"Lines and layers"},
    {"type":"textarea","id":"panel_2_body","label":"Panel 02 body","default":"Curved ribs divide the side panels. Follow their edges across the profile."},
    {"type":"text","id":"panel_2_specs","label":"Panel 02 spec chips","default":"Contoured midsole, Curved ribs, Heel clip"},
    {"type":"text","id":"panel_3_title","label":"Panel 03 title","default":"The foundation"},
    {"type":"textarea","id":"panel_3_body","label":"Panel 03 body","default":"The midsole and outsole give the silhouette its shape from below."},
    {"type":"text","id":"panel_3_specs","label":"Panel 03 spec chips","default":"Rubber tread, Flex grooves, Sculpted arch"},
    {"type":"header","content":"Detail photography"},
    {"type":"paragraph","content":"Empty slots show labeled temporary concept studies. Supplied images fill the frame without the concept zoom; use tightly composed detail photographs."},
    {"type":"image_picker","id":"panel_1_image","label":"Panel 01 detail image"},
    {"type":"checkbox","id":"panel_1_image_is_concept","label":"Panel 01 image is concept art","default":false},
    {"type":"image_picker","id":"panel_2_image","label":"Panel 02 detail image"},
    {"type":"checkbox","id":"panel_2_image_is_concept","label":"Panel 02 image is concept art","default":false},
    {"type":"image_picker","id":"panel_3_image","label":"Panel 03 detail image"},
    {"type":"checkbox","id":"panel_3_image_is_concept","label":"Panel 03 image is concept art","default":false}
  ],
  "presets":[{"name":"Materials"}]
}
{% endschema %}
