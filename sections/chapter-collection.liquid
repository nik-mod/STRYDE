{% liquid
  assign collection = section.settings.collection
  assign has_products = false
  if collection != blank and collection.products_count > 0
    assign has_products = true
  endif
  assign form_edit = false
  if section.settings.use_form_edit and has_products == false
    assign form_edit = true
  endif
  assign field_1 = section.settings.field_1 | default: '#41b4f0'
  assign field_2 = section.settings.field_2 | default: '#7fa9f6'
  assign field_3 = section.settings.field_3 | default: '#4fc4d4'
%}
<section id="chapter-collection" class="chapter chapter-paper chapter-collection" {% if section.settings.use_tn_model %} data-tn-editorial{% endif %} {% if form_edit %}data-form-edit{% endif %} data-chapter="collection" data-env="collection" data-section-id="{{ section.id }}" aria-labelledby="CollHeading-{{ section.id }}">
  <div class="coll-head">
    <p class="chapter-kicker">{{ section.settings.kicker | escape }}</p>
    <h2 class="chapter-heading" id="CollHeading-{{ section.id }}">
      <span class="heading-line"><span>{{ section.settings.heading | upcase | escape }}</span></span>
    </h2>
    {% if has_products %}<p class="coll-count">{{ 'collection.product_count' | t: count: collection.products_count }}</p>{% endif %}
  </div>
  <div class="coll-stage" data-coll-stage>
    {% if has_products %}
      {% for product in collection.products limit: 3 %}
        <article class="coll-scene" data-coll-scene style="--scene-field: {% cycle field_1, field_2, field_3 %}">
          <span class="coll-scene-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="coll-scene-art">
            <a class="coll-scene-figure" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              <span class="coll-scene-visual" data-coll-visual>
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 900px) 56vw, 92vw', alt: product.featured_image.alt }}
                {% else %}
                  <span class="coll-image-pending">{{ 'hero.asset_pending' | t }}</span>
                {% endif %}
              </span>
            </a>
          </div>
          <div class="coll-scene-copy">
            <h3 class="coll-scene-name"><span class="scene-line"><span><a href="{{ product.url }}">{{ product.title | escape }}</a></span></span></h3>
            <p class="coll-scene-price">{% if product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ product.price | money_with_currency }}</p>
            {% if product.available %}<a class="coll-scene-link" href="{{ product.url }}">{{ 'hero.details' | t }}</a>{% else %}<p class="coll-scene-link">{{ 'products.sold_out' | t }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    {% elsif form_edit %}
      {% render 'form-edit-scenes', section_id: section.id %}
    {% elsif section.preview_photography %}
      {% comment %} Local preview only: licensed owner photography stands in for the
         empty-merchandise state. Real Shopify products always take precedence, and an
         uploaded theme never receives this property. Credited and non-purchasable. {% endcomment %}
      {% for photo in section.preview_photography limit: 3 %}
        <article class="coll-scene" data-coll-scene style="--scene-field: {% cycle field_1, field_2, field_3 %}">
          <span class="coll-scene-num" aria-hidden="true">0{{ forloop.index }}</span>
          <div class="coll-scene-art">
            <div class="coll-scene-figure">
              <span class="coll-scene-visual" data-coll-visual>
                <img class="photo-card" src="{{ photo.asset | asset_url }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="{% if forloop.index == 1 %}eager{% else %}lazy{% endif %}" decoding="async" alt="{{ photo.name | escape }} — independent photographic reference">
              </span>
            </div>
          </div>
          <div class="coll-scene-copy">
            <h3 class="coll-scene-name"><span class="scene-line"><span>{{ photo.name | escape }}</span></span></h3>
            <p class="coll-scene-price">Photographic reference · Not store inventory</p>
            {% render 'photography-credit', photo: photo %}
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% for index in (1..3) %}
        {% liquid
          assign image_key = 'scene_' | append: index | append: '_image'
          assign concept_key = image_key | append: '_is_concept'
          assign image_slot = 'collection_' | append: index
          assign bundled_study = false
          if section.settings[image_key] == blank
            assign bundled_study = true
          endif
          if section.settings.use_tn_model and index == 2 and bundled_study
            assign image_slot = 'collection_1'
          endif
        %}
        {% case index %}{% when 1 %}{% assign tn_view = 'tn-angle-2800.webp' %}{% assign tn_title = 'Three-quarter view' %}{% when 2 %}{% assign tn_view = 'tn-heel-2800.webp' %}{% assign tn_title = 'Heel view' %}{% when 3 %}{% assign tn_view = 'tn-top-2800.webp' %}{% assign tn_title = 'From above' %}{% endcase %}
        <article class="coll-scene" data-coll-scene style="--scene-field: {% cycle field_1, field_2, field_3 %}">
          <span class="coll-scene-num" aria-hidden="true">0{{ index }}</span>
          <div class="coll-scene-art">
            <div class="coll-scene-figure">
              {% assign use_tn_view = false %}
              {% if section.settings.use_tn_model and index == 1 and section.settings[image_key] == blank %}{% assign use_tn_view = true %}{% endif %}
              <span class="coll-scene-visual" data-coll-visual>
                {% if use_tn_view %}
                  <img data-model-editorial-image src="{{ tn_view | asset_url }}" srcset="{{ tn_view | replace: '-2800.webp', '-1000.webp' | asset_url }} 1000w, {{ tn_view | asset_url }} 2800w" sizes="(min-width: 900px) 56vw, 92vw" width="2800" height="2100" loading="lazy" alt="Blue and white TN — {{ tn_title | escape }} 3D model preview">
                  <span class="asset-tag">{{ 'hero.model_preview' | t }}</span>
                {% else %}
                  {% render 'presentation-image', slot: image_slot, image: section.settings[image_key], image_is_concept: section.settings[concept_key], sizes: '(min-width: 900px) 56vw, 92vw' %}
                {% endif %}
              </span>
            </div>
          </div>
          <div class="coll-scene-copy">
            <h3 class="coll-scene-name"><span class="scene-line"><span>{% if use_tn_view %}{{ 'collection.tn_study' | t }}{% elsif bundled_study and index == 2 %}{{ 'collection.chrome_study' | t }}{% elsif bundled_study and index == 3 %}{{ 'collection.chrome_rear' | t }}{% else %}{{ section.settings.tile_title | escape }} 0{{ index }}{% endif %}</span></span></h3>
            <p class="coll-scene-price">{% if use_tn_view %}{{ 'collection.model_note' | t }}{% elsif bundled_study and index == 3 %}{{ 'collection.chrome_rear_note' | t }}{% elsif bundled_study %}{{ 'collection.concept_note' | t }}{% elsif section.settings[concept_key] %}{{ 'assets.concept_tag' | t }}{% else %}{{ 'collection.image_note' | t }}{% endif %}</p>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
  <div class="chapter-summary coll-summary">
    <p>{% if has_products %}{{ collection.title | escape }}{% elsif form_edit %}Photographic references · Not store inventory{% else %}Three silhouettes. Three perspectives.{% endif %}</p>
    <a href="{{ collection.url | default: routes.all_products_collection_url }}">{{ 'general.explore_collection' | t }} {% render 'icon', name: 'arrow' %}</a>
  </div>
</section>
{% schema %}
{
  "name":"Collection reveal",
  "settings":[
    {"type":"checkbox","id":"use_form_edit","label":"Show four-look form edit","default":false,"info":"Curated photographs with color and material titles. Assigned collection products take precedence."},
    {"type":"checkbox","id":"use_tn_model","label":"Use TN model editorial images","default":false},
    {"type":"text","id":"kicker","label":"Kicker","default":"05 \u2014 The collection"},
    {"type":"text","id":"heading","label":"Heading","default":"The lineup"},
    {"type":"collection","id":"collection","label":"Collection","info":"The first three products play as a cinematic sequence. Without a collection, labeled concept studies stand in."},
    {"type":"color","id":"field_1","label":"Product 01 field","default":"#41b4f0"},
    {"type":"color","id":"field_2","label":"Product 02 field","default":"#7fa9f6"},
    {"type":"color","id":"field_3","label":"Product 03 field","default":"#4fc4d4"},
    {"type":"text","id":"tile_title","label":"Concept tile title","default":"Concept"},
    {"type":"header","content":"Standalone scene images"},
    {"type":"paragraph","content":"Used only without an assigned collection. Assigned products always use their own images. Empty slots show labeled temporary artwork."},
    {"type":"image_picker","id":"scene_1_image","label":"Scene 01 image"},
    {"type":"checkbox","id":"scene_1_image_is_concept","label":"Scene 01 image is concept art","default":false},
    {"type":"image_picker","id":"scene_2_image","label":"Scene 02 image"},
    {"type":"checkbox","id":"scene_2_image_is_concept","label":"Scene 02 image is concept art","default":false},
    {"type":"image_picker","id":"scene_3_image","label":"Scene 03 image"},
    {"type":"checkbox","id":"scene_3_image_is_concept","label":"Scene 03 image is concept art","default":false}
  ],
  "presets":[{"name":"Collection reveal"}]
}
{% endschema %}
