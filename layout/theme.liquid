<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'social-meta' %}
    {{ content_for_header }}
    {{ 'archivo-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {{ 'archivo-var-italic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
    <style>
      :root { --paper: {{ settings.background | default: '#41b4f0' }}; --ink: {{ settings.foreground | default: '#073653' }}; --accent: {{ settings.accent | default: '#adfff5' }}; --surface: {{ settings.surface | default: '#effaff' }}; --hero-type: {{ settings.hero_type | default: '#c1fff8' }}; }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'refinements.css' | asset_url | stylesheet_tag }}
    {{ 'recovery.css' | asset_url | stylesheet_tag }}
    {{ 'signature.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}{{ 'experience.css' | asset_url | stylesheet_tag }}{{ 'form-edit.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'storefront.css' | asset_url | stylesheet_tag }}
    {{ 'navigation.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}{{ 'campaign-refinement.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'collection' %}{{ 'collection-studio.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' %}{{ 'product-studio.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'index' %}
      {{ 'site-intro.css' | asset_url | stylesheet_tag }}
      {% unless request.design_mode %}
        <script>
          (() => {
            try {
              const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
              const navigationType = performance.getEntriesByType('navigation')[0]?.type || 'navigate';
              let marker = null;
              try {
                marker = JSON.parse(sessionStorage.getItem('stryde:intro-internal-return:v1') || 'null');
                sessionStorage.removeItem('stryde:intro-internal-return:v1');
                sessionStorage.removeItem('stryde:intro-seen:v1');
              } catch { /* Navigation still works when session storage is blocked. */ }
              const internalReferrer = document.referrer && new URL(document.referrer).origin === location.origin;
              const recentReturn = marker && marker.path === location.pathname && Number.isFinite(marker.time) && Date.now() >= marker.time && Date.now() - marker.time < 15000;
              const internalReturn = navigationType === 'navigate' && (internalReferrer || recentReturn);
              if (internalReturn || reduced || navigationType === 'back_forward' || location.hash) return;
              document.documentElement.classList.add('site-intro-pending');
              setTimeout(() => document.documentElement.classList.remove('site-intro-pending'), 10000);
            } catch { /* The homepage remains available if the introduction cannot start. */ }
          })();
        </script>
      {% endunless %}
    {% endif %}
    <script>document.documentElement.classList.replace('no-js','js');</script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
  </head>
  <body class="template-{{ request.page_type | handle }}">
    {% if request.page_type == 'index' %}{% render 'site-intro' %}{% endif %}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% if request.page_type == 'index' %}{% render 'journey-nav' %}{% endif %}
    {% sections 'footer-group' %}
    <div class="sr-only" id="CartStatus" role="status" aria-live="polite"></div>
  </body>
</html>
