<header class="site-header">
  {% if section.settings.announcement != blank %}
  <div class="announcement-bar">
    {% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement | escape }}</a>{% else %}<span>{{ section.settings.announcement | escape }}</span>{% endif %}
  </div>
  {% endif %}
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }} — {{ 'general.home' | t }}">
    {% if settings.logo != blank %}{{ settings.logo | image_url: width: 400 | image_tag: widths: '120, 200, 400', width: 160, loading: 'eager', alt: settings.brand_name }}{% else %}{{ settings.brand_name | default: shop.name | escape }}{% endif %}
  </a>
  <nav class="desktop-nav" aria-label="{{ 'general.main_navigation' | t }}">
    {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.collection' | t }}</a>{% if request.page_type == 'index' %}<a href="#chapter-deconstruction">{{ 'general.the_details' | t }}</a><a href="#chapter-brand">{{ 'general.our_perspective' | t }}</a>{% endif %}{% endif %}
  </nav>
  <div class="header-actions">
    {% if shop.customer_accounts_enabled %}<a class="account-link icon-link" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>{% endif %}
    <a class="header-search-link" href="{% if request.page_type == 'collection' and collection.url == routes.all_products_collection_url %}#CollectionSearch{% else %}{{ routes.all_products_collection_url }}#CollectionSearch{% endif %}">{{ 'general.search' | t }}</a>
    <a class="bag-link" href="{{ routes.cart_url }}"{% unless request.page_type == 'cart' %} data-cart-open aria-haspopup="dialog"{% endunless %} aria-label="{{ 'cart.title' | t }} ({{ cart.item_count }})">{% render 'icon', name: 'bag' %}<span class="bag-count" data-cart-count>{{ cart.item_count }}</span></a>
    <details class="mobile-menu" data-mobile-menu data-open-label="{{ 'general.menu' | t | escape }}" data-close-label="{{ 'general.close_menu' | t | escape }}">
      <summary aria-label="{{ 'general.menu' | t }}"><span></span><span></span></summary>
      <nav class="mobile-menu-panel" aria-label="{{ 'general.mobile_navigation' | t }}">
        {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.collection' | t }}</a>{% if request.page_type == 'index' %}<a href="#chapter-deconstruction">{{ 'general.the_details' | t }}</a><a href="#chapter-brand">{{ 'general.our_perspective' | t }}</a>{% endif %}{% endif %}
        <a href="{{ routes.all_products_collection_url }}#CollectionSearch">{{ 'general.search' | t }}</a>
        <a href="{{ routes.cart_url }}">{{ 'cart.title' | t }} ({{ cart.item_count }})</a>
      </nav>
    </details>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Navigation menu"},{"type":"header","content":"Announcement"},{"type":"text","id":"announcement","label":"Announcement text","info":"Shows above the navigation only when filled, for example a seasonal campaign or free-shipping threshold you configured in Shopify."},{"type":"url","id":"announcement_link","label":"Announcement link"}]}
{% endschema %}
