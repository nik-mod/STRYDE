<section class="page-shell auth-page" data-account-reset>
  <div class="auth-panel">
    <header class="page-heading"><span class="micro">{{ shop.name | escape }}</span><h1>{{ 'customer.reset_title' | t }}</h1></header>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <label for="ResetPassword">{{ 'customer.sign_in_password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" minlength="5" required>
      <label for="ResetPasswordConfirm">{{ 'customer.sign_in_password' | t }}</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" minlength="5" required>
      <button class="button button-dark button-full" type="submit">{{ 'customer.reset_submit' | t }}</button>
    {% endform %}
  </div>
</section>
{% schema %}{"name":"Reset password","settings":[]}{% endschema %}
